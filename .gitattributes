# Auto-detect text vs binary, normalize text → LF in repository
* text=auto

# Source files — LF
*.java        text eol=lf
*.kt          text eol=lf
*.kts         text eol=lf
*.gradle      text eol=lf
*.xml         text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.json        text eol=lf
*.properties  text eol=lf
*.md          text eol=lf
*.sh          text eol=lf
*.sql         text eol=lf
*.html        text eol=lf
*.css         text eol=lf
*.js          text eol=lf
*.ts          text eol=lf
Dockerfile    text eol=lf
Makefile      text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# Maven wrapper — Unix script needs LF
/mvnw         text eol=lf

# Windows scripts — CRLF
*.bat         text eol=crlf
*.cmd         text eol=crlf

# Binary — no text processing, no diff noise
*.jar         binary
*.class       binary
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.ico         binary
*.svg         text eol=lf
*.zip         binary
*.tar         binary
*.tar.gz      binary
*.tgz         binary
*.gz          binary
*.keystore    binary
*.jks         binary
*.p12         binary
*.pdf         binary

# GitHub Linguist hints
*.sql         linguist-language=SQL
